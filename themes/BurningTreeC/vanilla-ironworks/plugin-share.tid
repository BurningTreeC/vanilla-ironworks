<$list filter="[[$:/plugins/tiddlywiki/share]is[tiddler]]" variable="ignore">

/* ==========================================================================
** Share
**
** The wizard is a well sunk into the page - the plugin says so with
** `inset 0px 2px 3px 2px rgba(0,0,0,0.4)`, which is a heavy black shadow that
** looks like a bruise on cream and disappears on a dark ground. The same idea
** reads better as a recessed plate: the editor's own background, one hairline,
** and a shadow built from the palette's ink instead of from black.
** ========================================================================== */

.tc-sharing-wizard-wrapper {
	inline-size: 100%;
	padding: var(--iw-space-md);
	margin-block-end: var(--iw-space-md);
	background: var(--tpc-tiddler-editor-background);
	border: 1px solid var(--iw-rule-faint);
	border-radius: var(--iw-radius);
	box-shadow: inset 0 1px 3px var(--iw-shadow-soft);
}

/* The URL to share is the point of the whole screen, so it is set in the code
   face - it is a string to be read character by character, not prose - and
   given room to be selected. */
input.tc-sharing-wizard-editor {
	inline-size: 100%;
	padding: var(--iw-space-xs) var(--iw-space-sm);
	background: var(--tpc-tiddler-background);
	border: 1px solid var(--tpc-tiddler-editor-border);
	border-radius: var(--iw-radius);
	font-family: var(--iw-font-code);
	font-size: 0.875rem;
}

input.tc-sharing-wizard-editor:focus-visible {
	outline: 2px solid var(--iw-focus);
	outline-offset: 1px;
}

</$list>
